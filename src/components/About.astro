---
import Photo from './Photo.astro';

interface Props {
	eyebrow: string;
	titleLine1: string;
	titleLine2: string;
	paragraph1Before: string;
	motto: string;
	paragraph1After: string;
	paragraph2: string;
	image?: string | null;
}

const { eyebrow, titleLine1, titleLine2, paragraph1Before, motto, paragraph1After, paragraph2, image } = Astro.props;
---

<div id="over" class="about">
	<div class="about-media" data-reveal>
		<Photo src={image} alt="Portret Mariëtte" label={'FOTO — portret Mariëtte,\nbuiten, natuurlijk licht'} class="about-photo" />
	</div>
	<div>
		<div class="eyebrow" data-reveal>{eyebrow}</div>
		<h2 class="about-title" data-reveal>{titleLine1}<br />{titleLine2}</h2>
		<p class="about-text" data-reveal>
			{paragraph1Before} <span class="motto" data-motto><span class="motto-line" data-motto-line></span
				>{motto}</span> {paragraph1After}
		</p>
		<p class="about-text" data-reveal>{paragraph2}</p>
		<a href="#blog" class="btn btn-bordered" data-reveal>Lees mijn verhaal</a>
	</div>
</div>

<style>
	.about {
		display: grid;
		grid-template-columns: 0.9fr 1.1fr;
		gap: clamp(40px, 6vw, 90px);
		padding: clamp(60px, 7vw, 110px) clamp(24px, 4vw, 60px);
		align-items: center;
	}

	.about-media {
		position: relative;
	}

	.about-media :global(.about-photo) {
		aspect-ratio: 4 / 5;
		border-radius: 34px;
		align-items: flex-end;
		padding: 20px;
		white-space: pre-line;
	}

	.about-title {
		margin: 0 0 28px;
		font-family: var(--font-display);
		font-weight: 300;
		font-size: clamp(36px, 4.2vw, 56px);
		line-height: 1.06;
		text-wrap: balance;
	}

	.about-text {
		margin: 0 0 20px;
		font-size: 17px;
		line-height: 1.85;
		font-weight: 300;
		color: var(--color-text-muted);
		max-width: 56ch;
		text-wrap: pretty;
	}

	.motto {
		position: relative;
		display: inline-block;
		font-family: var(--font-display);
		font-style: italic;
		font-size: 22px;
		line-height: 1;
		color: #7d5f3e;
		white-space: nowrap;
	}

	.motto-line {
		position: absolute;
		left: 0;
		right: 0;
		bottom: -3px;
		height: 2px;
		background: var(--color-gold-light);
		border-radius: 2px;
		transform: scaleX(0);
		transform-origin: left;
	}

	.about :global(.btn-bordered) {
		margin-top: 14px;
	}

	@media (max-width: 780px) {
		.about {
			grid-template-columns: 1fr;
		}
	}
</style>
