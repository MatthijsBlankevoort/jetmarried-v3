---
import Photo from './Photo.astro';
import { useTranslations } from '../i18n/ui';

interface Props {
	eyebrow: string;
	titleLine1: string;
	titleLine2: string;
	paragraph1Before: string;
	motto: string;
	paragraph1After: string;
	paragraph2: string;
	image?: string | null;
	storyHref: string;
	speechExcerpt?: string;
	speechCaption?: string;
}

const {
	eyebrow,
	titleLine1,
	titleLine2,
	paragraph1Before,
	motto,
	paragraph1After,
	paragraph2,
	image,
	storyHref,
	speechExcerpt,
	speechCaption,
} = Astro.props;
const t = useTranslations(Astro.currentLocale);
---

<section id="over" class="about">
	<div class="about-media" data-reveal>
		<Photo src={image} alt={t('about.photoAlt')} label={t('about.photoLabel')} class="about-photo" />
	</div>
	<div>
		<div class="eyebrow" data-reveal>{eyebrow}</div>
		<h2 class="about-title" data-reveal>{titleLine1}<br />{titleLine2}</h2>
		<p class="about-text" data-reveal>
			{paragraph1Before} <span class="motto" data-motto><span class="motto-line" data-motto-line></span
				>{motto}</span> {paragraph1After}
		</p>
		<p class="about-text" data-reveal>{paragraph2}</p>
		{
			speechExcerpt && (
				<figure class="about-excerpt" data-reveal>
					<blockquote>{speechExcerpt}</blockquote>
					{speechCaption && <figcaption>{speechCaption}</figcaption>}
				</figure>
			)
		}
		<a href={storyHref} class="btn btn-bordered" data-reveal>{t('about.cta')}</a>
	</div>
</section>

<style>
	.about {
		display: grid;
		grid-template-columns: 0.9fr 1.1fr;
		gap: clamp(40px, 6vw, 90px);
		padding: clamp(60px, 7vw, 110px) clamp(24px, 4vw, 60px);
		align-items: center;
	}

	.about-media {
		position: relative;
	}

	.about-media :global(.about-photo) {
		aspect-ratio: 4 / 5;
		border-radius: 34px;
		align-items: flex-end;
		padding: 20px;
		white-space: pre-line;
	}

	.about-title {
		margin: 0 0 28px;
		font-family: var(--font-display);
		font-weight: 300;
		font-size: clamp(36px, 4.2vw, 56px);
		line-height: 1.06;
		text-wrap: balance;
	}

	.about-text {
		margin: 0 0 20px;
		font-size: 17px;
		line-height: 1.85;
		font-weight: 300;
		color: var(--color-text-muted);
		max-width: 56ch;
		text-wrap: pretty;
	}

	.motto {
		position: relative;
		z-index: 0;
		display: inline-block;
		padding: 0 0.12em;
		font-family: var(--font-display);
		font-style: italic;
		font-size: 1.35em;
		line-height: 1;
		color: var(--color-gold-deep);
		white-space: nowrap;
	}

	/* A soft highlighter swash behind the motto, drawn in on scroll. */
	.motto-line {
		position: absolute;
		z-index: -1;
		left: 0;
		right: 0;
		bottom: 0.04em;
		height: 0.42em;
		background: var(--color-gold-pale);
		border-radius: 14px;
		transform: scaleX(0);
		transform-origin: left;
	}

	.about-excerpt {
		margin: 30px 0 28px;
		padding-left: clamp(18px, 2vw, 28px);
		border-left: 1px solid var(--color-gold-light);
		max-width: 52ch;
	}

	.about-excerpt blockquote {
		margin: 0;
		font-family: var(--font-display);
		font-style: italic;
		font-weight: 300;
		font-size: clamp(22px, 2vw, 27px);
		line-height: 1.4;
		color: var(--color-text);
		text-wrap: pretty;
	}

	.about-excerpt figcaption {
		margin-top: 12px;
		font-size: 13px;
		color: var(--color-text-muted);
	}

	.about :global(.btn-bordered) {
		margin-top: 14px;
	}

	@media (max-width: 780px) {
		.about {
			grid-template-columns: 1fr;
		}
	}
</style>
