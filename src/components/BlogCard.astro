---
import Photo from './Photo.astro';

interface Props {
	slug: string;
	title: string;
	excerpt: string;
	date: Date;
	cover?: string | null;
	coverLabel: string;
}

const { slug, title, excerpt, date, cover, coverLabel } = Astro.props;

const dateLabel = date.toLocaleDateString('nl-NL', { day: 'numeric', month: 'long', year: 'numeric' });
---

<a href={`/blog/${slug}/`} class="blog-card">
	<Photo src={cover} alt={title} label={coverLabel} class="blog-photo" />
	<div class="blog-date">{dateLabel}</div>
	<h4 class="blog-title">{title}</h4>
	<p class="blog-excerpt">{excerpt}</p>
</a>

<style>
	.blog-card {
		display: flex;
		flex-direction: column;
		height: 100%;
		border-radius: 30px;
		background: var(--color-panel-2);
		border: 1px solid var(--color-border);
		padding: 20px 20px 28px;
		transition: border-color 0.35s ease, transform 0.35s ease;
	}

	.blog-card:hover {
		border-color: var(--color-border-strong);
		transform: translateY(-6px);
	}

	.blog-card :global(.blog-photo) {
		aspect-ratio: 3 / 2;
		border-radius: 20px;
		padding: 14px;
		margin-bottom: 20px;
	}

	.blog-card :global(.blog-photo img) {
		transition: transform 0.5s ease;
	}

	.blog-card:hover :global(.blog-photo img) {
		transform: scale(1.06);
	}

	.blog-title {
		transition: color 0.3s ease;
	}

	.blog-card:hover .blog-title {
		color: var(--color-gold);
	}

	.blog-date {
		font-size: 11.5px;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--color-gold);
		margin: 0 4px 10px;
	}

	.blog-title {
		margin: 0 4px 10px;
		font-family: var(--font-display);
		font-weight: 400;
		font-size: 27px;
		line-height: 1.15;
	}

	.blog-excerpt {
		margin: 0 4px;
		flex: 1;
		font-size: 15px;
		line-height: 1.75;
		font-weight: 300;
		color: var(--color-text-muted);
	}
</style>
