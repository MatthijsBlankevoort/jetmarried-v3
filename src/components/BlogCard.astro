---
import Photo from './Photo.astro';
import { formatDate, localePath, toLocale } from '../i18n/ui';

interface Props {
	slug: string;
	title: string;
	excerpt: string;
	date: Date;
	cover?: string | null;
	coverLabel: string;
}

const { slug, title, excerpt, date, cover, coverLabel } = Astro.props;

const locale = toLocale(Astro.currentLocale);
const dateLabel = formatDate(date, locale);
---

<a href={localePath(locale, `/blog/${slug}/`)} class="blog-card">
	<Photo src={cover} alt="" label={coverLabel} class="blog-photo" />
	<time class="blog-date" datetime={date.toISOString().slice(0, 10)}>{dateLabel}</time>
	<h3 class="blog-title">{title}</h3>
	<p class="blog-excerpt">{excerpt}</p>
</a>

<style>
	.blog-card {
		display: flex;
		flex-direction: column;
		height: 100%;
		border-radius: 26px;
		background: var(--color-panel-2);
		border: 1px solid var(--color-border);
		padding: 20px 20px 28px;
		transition: border-color 0.35s ease, transform 0.35s ease;
	}

	.blog-card:focus-visible {
		outline: 2px solid var(--color-gold);
		outline-offset: 3px;
	}

	.blog-card:hover {
		border-color: var(--color-border-strong);
		transform: translateY(-6px);
	}

	@media (prefers-reduced-motion: reduce) {
		.blog-card,
		.blog-card :global(.blog-photo img) {
			transition: none;
		}

		.blog-card:hover {
			transform: none;
		}
	}

	.blog-card :global(.blog-photo) {
		aspect-ratio: 3 / 2;
		border-radius: 14px;
		padding: 14px;
		margin-bottom: 20px;
	}

	.blog-card :global(.blog-photo img) {
		transition: transform 0.5s ease;
	}

	.blog-card:hover :global(.blog-photo img) {
		transform: scale(1.06);
	}

	.blog-title {
		transition: color 0.3s ease;
	}

	.blog-card:hover .blog-title {
		color: var(--color-gold-deep);
	}

	.blog-date {
		font-size: 11.5px;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--color-gold-deep);
		margin: 0 4px 10px;
	}

	.blog-title {
		margin: 0 4px 10px;
		font-family: var(--font-display);
		font-weight: 400;
		font-size: 27px;
		line-height: 1.15;
	}

	.blog-excerpt {
		margin: 0 4px;
		flex: 1;
		font-size: 15px;
		line-height: 1.75;
		font-weight: 300;
		color: var(--color-text-muted);
	}
</style>
