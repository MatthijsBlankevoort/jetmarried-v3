---
import CeremonyCard from './CeremonyCard.astro';

interface Ceremony {
	id: string;
	title: string;
	imageLabel: string;
	image?: string;
	description: string;
	bullets: string[];
}

interface Props {
	intro: { title: string; text: string };
	ceremonies: Ceremony[];
}

const { intro, ceremonies } = Astro.props;
---

<div id="ceremonies" class="ceremonies-outer">
	<div class="ceremonies-head">
		<h2 class="section-title" data-reveal>{intro.title}</h2>
		<p class="ceremonies-intro" data-reveal>{intro.text}</p>
	</div>
	<div class="ceremonies-list">
		{ceremonies.map((c, i) => <CeremonyCard {...c} flip={i % 2 === 1} />)}
	</div>
</div>

<style>
	.ceremonies-outer {
		padding: clamp(60px, 7vw, 110px) clamp(24px, 4vw, 60px);
	}

	.ceremonies-head {
		display: flex;
		flex-wrap: wrap;
		align-items: flex-end;
		justify-content: space-between;
		gap: 24px;
		margin-bottom: 44px;
	}

	.ceremonies-head :global(.section-title) {
		max-width: 14ch;
	}

	.ceremonies-intro {
		margin: 0;
		max-width: 340px;
		font-size: 15.5px;
		line-height: 1.75;
		font-weight: 300;
		color: #5a554d;
		text-wrap: pretty;
	}

	.ceremonies-list {
		display: flex;
		flex-direction: column;
		gap: 18px;
		scroll-snap-type: y proximity;
	}

	.ceremonies-list > :global(*) {
		scroll-snap-align: center;
	}
</style>
