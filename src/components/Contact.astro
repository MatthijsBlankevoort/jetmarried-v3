---
interface Props {
	titleLine1: string;
	titleLine2: string;
	text: string;
	contactName: string;
	phone: string;
	phoneHref: string;
	email: string;
	priceNote: string;
}

const { titleLine1, titleLine2, text, contactName, phone, phoneHref, email, priceNote } = Astro.props;
---

<div id="contact" class="contact-outer">
	<div class="contact-panel">
		<div>
			<div class="contact-eyebrow" data-reveal>Contact</div>
			<h2 class="contact-title" data-reveal>{titleLine1}<br />{titleLine2}</h2>
			<p class="contact-text" data-reveal>{text}</p>
			<div class="contact-details" data-reveal>
				<div>{contactName}</div>
				<a href={`tel:${phoneHref}`}>{phone}</a>
				<a href={`mailto:${email}`}>{email}</a>
			</div>
			<div class="contact-price" data-reveal>{priceNote}</div>
		</div>
		<form class="contact-form" data-reveal>
			<label class="form-field">
				<span class="form-label">Naam</span>
				<input type="text" name="name" />
			</label>
			<label class="form-field">
				<span class="form-label">E-mail</span>
				<input type="email" name="email" />
			</label>
			<label class="form-field">
				<span class="form-label">Bericht</span>
				<textarea name="message" rows="4"></textarea>
			</label>
			<label class="form-consent">
				<input type="checkbox" name="consent" />
				Ik ga akkoord met de privacyverklaring
			</label>
			<button type="submit" class="btn form-submit">Versturen</button>
		</form>
	</div>
</div>

<style>
	.contact-outer {
		padding: 0 14px 14px;
	}

	.contact-panel {
		border-radius: 44px;
		background: var(--color-dark);
		color: var(--color-dark-text);
		padding: clamp(56px, 6vw, 96px) clamp(28px, 4vw, 60px);
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: clamp(40px, 5vw, 80px);
	}

	.contact-eyebrow {
		font-size: 12px;
		letter-spacing: 0.22em;
		text-transform: uppercase;
		color: var(--color-dark-accent);
		margin-bottom: 22px;
	}

	.contact-title {
		margin: 0 0 24px;
		font-family: var(--font-display);
		font-weight: 300;
		font-size: clamp(38px, 4.4vw, 58px);
		line-height: 1.02;
	}

	.contact-text {
		margin: 0 0 38px;
		font-size: 17px;
		line-height: 1.85;
		font-weight: 300;
		opacity: 0.82;
		max-width: 44ch;
		text-wrap: pretty;
	}

	.contact-details {
		display: flex;
		flex-direction: column;
		gap: 14px;
		font-size: 16px;
		font-weight: 300;
		opacity: 0.86;
	}

	.contact-price {
		margin-top: 40px;
		padding: 20px 24px;
		border-radius: 22px;
		background: rgba(242, 238, 230, 0.07);
		border: 1px solid rgba(242, 238, 230, 0.14);
		font-size: 14.5px;
		line-height: 1.8;
		font-weight: 300;
		opacity: 0.72;
		max-width: 44ch;
	}

	.contact-form {
		border-radius: 32px;
		background: rgba(242, 238, 230, 0.06);
		border: 1px solid rgba(242, 238, 230, 0.13);
		padding: clamp(28px, 3vw, 42px);
		display: flex;
		flex-direction: column;
		gap: 20px;
	}

	.form-field {
		display: block;
	}

	.form-label {
		display: block;
		font-size: 12.5px;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		opacity: 0.6;
		margin-bottom: 9px;
	}

	.form-field input,
	.form-field textarea {
		width: 100%;
		border-radius: 14px;
		background: rgba(242, 238, 230, 0.08);
		border: 1px solid rgba(242, 238, 230, 0.14);
		color: var(--color-dark-text);
		font-family: var(--font-body);
		font-size: 15px;
		padding: 14px 16px;
		resize: vertical;
	}

	.form-field input {
		height: 48px;
	}

	.form-field textarea {
		min-height: 124px;
	}

	.form-field input:focus-visible,
	.form-field textarea:focus-visible {
		outline: 2px solid var(--color-dark-accent);
		outline-offset: 1px;
		border-color: var(--color-dark-accent);
	}

	.form-consent {
		display: flex;
		align-items: center;
		gap: 11px;
		font-size: 13.5px;
		font-weight: 300;
		opacity: 0.72;
	}

	.form-consent input {
		width: 17px;
		height: 17px;
		border-radius: 6px;
		accent-color: var(--color-dark-accent);
	}

	.form-submit {
		align-self: flex-start;
		margin-top: 6px;
		padding: 16px 38px;
		background: var(--color-panel);
		color: var(--color-text);
		font-size: 14.5px;
		letter-spacing: 0.02em;
		border: none;
		cursor: pointer;
	}

	.form-submit:hover {
		background: var(--color-dark-accent);
		color: var(--color-text);
	}

	@media (max-width: 780px) {
		.contact-panel {
			grid-template-columns: 1fr;
		}
	}
</style>
