---
import { useTranslations } from '../i18n/ui';

interface FaqItem {
	q: string;
	a: string;
}

interface Props {
	faqs: FaqItem[];
	phone: string;
	phoneHref: string;
}

const { faqs, phone, phoneHref } = Astro.props;
const t = useTranslations(Astro.currentLocale);
---

<section class="faq-outer" aria-labelledby="faq-title">
	<div>
		<h2 id="faq-title" class="section-title faq-title" data-reveal>{t('faq.title')}</h2>
		<p class="faq-intro" data-reveal>
			{t('faq.intro')} <a href={`tel:${phoneHref}`} class="faq-phone">{phone}</a>
		</p>
	</div>
	<div class="faq-list">
		{
			faqs.map((item, i) => (
				<div class="faq-item" class:list={{ 'faq-item-open': i === 0 }} data-faq={i} data-reveal>
					<h3 class="faq-h">
						<button type="button" class="faq-q" data-faq-q={i} aria-expanded={i === 0 ? 'true' : 'false'} aria-controls={`faq-a-${i}`}>
							<span class="faq-q-text">{item.q}</span>
							<span class="faq-icon" aria-hidden="true">
								<span class="faq-icon-bar" />
								<span class="faq-icon-bar faq-icon-bar-v" />
							</span>
						</button>
					</h3>
					<div class="faq-a" id={`faq-a-${i}`} data-faq-a={i} inert={i !== 0}>
						<div>
							<p>{item.a}</p>
						</div>
					</div>
				</div>
			))
		}
	</div>
</section>

<style>
	.faq-outer {
		padding: clamp(60px, 7vw, 110px) clamp(24px, 4vw, 60px);
		display: grid;
		grid-template-columns: 0.8fr 1.2fr;
		gap: clamp(36px, 5vw, 80px);
	}

	.faq-title {
		margin: 0 0 18px;
		font-size: clamp(34px, 3.8vw, 50px);
		line-height: 1.05;
	}

	.faq-intro {
		margin: 0;
		font-size: 15.5px;
		line-height: 1.8;
		font-weight: 300;
		color: var(--color-text-muted);
	}

	.faq-phone {
		border-bottom: 1px solid var(--color-gold);
	}

	.faq-list {
		display: flex;
		flex-direction: column;
		gap: 10px;
	}

	.faq-item {
		border-radius: 26px;
		background: var(--color-panel-2);
		border: 1px solid transparent;
		overflow: hidden;
		transition: border-color 0.35s ease;
	}

	.faq-item-open {
		border-color: var(--color-border-strong);
	}

	.faq-q {
		display: grid;
		grid-template-columns: 1fr 34px;
		gap: 20px;
		align-items: center;
		width: 100%;
		padding: 24px 28px;
		background: none;
		border: none;
		font: inherit;
		color: inherit;
		text-align: left;
		cursor: pointer;
		user-select: none;
	}

	.faq-h {
		margin: 0;
		font: inherit;
	}

	.faq-q:focus-visible {
		outline: 2px solid var(--color-gold);
		outline-offset: -4px;
		border-radius: 26px;
	}

	.faq-q-text {
		margin: 0;
		font-size: 18px;
		font-weight: 500;
		letter-spacing: 0.01em;
		text-wrap: pretty;
	}

	.faq-icon {
		position: relative;
		width: 30px;
		height: 30px;
		border-radius: 50%;
		border: 1px solid var(--color-border-soft);
		display: block;
		transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1), border-color 0.35s ease, background 0.35s ease;
	}

	.faq-item-open .faq-icon {
		transform: rotate(180deg);
		background: var(--color-panel);
		border-color: var(--color-border-strong);
	}

	.faq-icon-bar {
		position: absolute;
		left: 50%;
		top: 50%;
		width: 11px;
		height: 1.5px;
		background: var(--color-text-muted);
		transform: translate(-50%, -50%);
	}

	.faq-icon-bar-v {
		width: 1.5px;
		height: 11px;
		transition: opacity 0.3s ease;
	}

	.faq-item-open .faq-icon-bar-v {
		opacity: 0;
	}

	/* Grid rows open to the content's own height without animating layout height. */
	.faq-a {
		display: grid;
		grid-template-rows: 0fr;
		transition: grid-template-rows 0.45s cubic-bezier(0.22, 1, 0.36, 1);
	}

	.faq-a > div {
		overflow: hidden;
		min-height: 0;
	}

	.faq-item-open .faq-a {
		grid-template-rows: 1fr;
	}

	@media (prefers-reduced-motion: reduce) {
		.faq-a,
		.faq-icon {
			transition: none;
		}
	}

	.faq-a p {
		margin: 0;
		padding: 0 28px 26px;
		font-size: 15.5px;
		line-height: 1.8;
		font-weight: 300;
		color: var(--color-text-muted);
		max-width: 60ch;
		text-wrap: pretty;
	}

	@media (max-width: 780px) {
		.faq-outer {
			grid-template-columns: 1fr;
		}
	}
</style>
