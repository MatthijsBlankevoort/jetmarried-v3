---
interface Props {
	contactName: string;
	kvk: string;
	socials: { label: string; href: string }[];
	logoUrl: string;
}

const { contactName, kvk, socials, logoUrl } = Astro.props;
const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
	<a href="#top" class="footer-logo">
		<img src={logoUrl} alt="Jetmarried" />
	</a>
	<span>© {currentYear} Jetmarried · {contactName} · KVK {kvk}</span>
	<span class="footer-links">
		{socials.map((s) => <a href={s.href}>{s.label}</a>)}
	</span>
</footer>

<style>
	.site-footer {
		display: flex;
		flex-wrap: wrap;
		gap: 20px;
		justify-content: space-between;
		align-items: center;
		max-width: 1600px;
		margin: 44px auto 48px;
		padding: 26px clamp(24px, 4vw, 60px) 0;
		border-top: 1px solid var(--color-border);
		color: var(--color-text-muted);
		font-size: 13.5px;
		font-weight: 300;
	}

	.footer-logo {
		display: flex;
		align-items: center;
	}

	.footer-logo img {
		/* The square logo file is mostly whitespace: crop to the rings and wordmark. */
		width: 96px;
		height: 48px;
		object-fit: cover;
		object-position: 50% 52%;
		display: block;
		mix-blend-mode: multiply;
	}

	.footer-links a:hover {
		color: var(--color-text);
	}

	.footer-links {
		display: flex;
		flex-wrap: wrap;
		gap: 10px 24px;
		font-size: 11.5px;
		letter-spacing: 0.16em;
		text-transform: uppercase;
	}
</style>
