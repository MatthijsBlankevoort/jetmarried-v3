---
interface Props {
	contactName: string;
	kvk: string;
	socials: { label: string; href: string }[];
}

const { contactName, kvk, socials } = Astro.props;
const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
	<span class="footer-logo">Jet<em>married</em></span>
	<span>© {currentYear} {contactName} · KVK {kvk}</span>
	<span class="footer-links">
		{socials.map((s) => <a href={s.href}>{s.label}</a>)}
	</span>
</footer>

<style>
	.site-footer {
		display: flex;
		flex-wrap: wrap;
		gap: 20px;
		justify-content: space-between;
		align-items: center;
		margin: 44px clamp(24px, 4vw, 60px) 48px;
		padding-top: 26px;
		border-top: 1px solid var(--color-border);
		color: var(--color-text-mutedest);
		font-size: 13.5px;
		font-weight: 300;
	}

	.footer-logo {
		font-family: var(--font-display);
		font-size: 19px;
		color: var(--color-text-muted);
	}

	.footer-logo em {
		font-style: italic;
		color: var(--color-gold);
	}

	.footer-links {
		display: flex;
		gap: 24px;
		font-size: 11.5px;
		letter-spacing: 0.16em;
		text-transform: uppercase;
	}
</style>
