---
import { locales, localeLabel, localePath, stripLocale, toLocale, useTranslations } from '../i18n/ui';

interface Props {
	nav: { label: string; href: string }[];
	logoUrl: string;
	headerCta: string;
}

const { nav, logoUrl, headerCta } = Astro.props;

const locale = toLocale(Astro.currentLocale);
const t = useTranslations(locale);
// The switcher keeps you on the same page: only the language prefix changes.
const path = stripLocale(Astro.url.pathname);
---

<header class="header-wrap" data-header>
	<div class="header-pill">
		<div class="header-sheen" aria-hidden="true"></div>

		<a href="#top" class="header-logo">
			<img src={logoUrl} alt="Jetmarried" />
		</a>

		<nav class="header-nav" aria-label={t('header.nav')}>
			{nav.map((link) => <a href={link.href}>{link.label}</a>)}
		</nav>

		<div class="header-actions">
			<div class="lang-switch" role="group" aria-label={t('header.language')}>
				{
					locales.map((l) =>
						l === locale ? (
							<span class="lang-active" aria-current="true">
								{localeLabel[l]}
							</span>
						) : (
							<a href={localePath(l, path)} hreflang={l}>
								{localeLabel[l]}
							</a>
						),
					)
				}
			</div>
			<a href="#contact" class="header-cta">{headerCta}</a>
		</div>

		<button type="button" class="header-burger" aria-label={t('header.menuToggle')} aria-expanded="false" aria-controls="mobile-nav" data-menu-toggle>
			<span></span>
			<span></span>
			<span></span>
		</button>
	</div>
</header>

<div class="mobile-nav" id="mobile-nav" data-mobile-nav>
	<nav aria-label={t('header.mobileNav')}>
		{nav.map((link) => <a href={link.href} data-menu-link>{link.label}</a>)}
	</nav>
	<div class="mobile-nav-footer">
		<div class="lang-switch" role="group" aria-label={t('header.language')}>
			{
				locales.map((l) =>
					l === locale ? (
						<span class="lang-active" aria-current="true">
							{localeLabel[l]}
						</span>
					) : (
						<a href={localePath(l, path)} hreflang={l}>
							{localeLabel[l]}
						</a>
					),
				)
			}
		</div>
		<a href="#contact" class="header-cta" data-menu-link>{headerCta}</a>
	</div>
</div>

<style>
	.header-wrap {
		position: fixed;
		top: 18px;
		left: 50%;
		transform: translateX(-50%);
		z-index: 90;
		width: min(1240px, calc(100% - 36px));
	}

	.header-pill {
		position: relative;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 22px;
		padding: 11px 11px 11px 26px;
		border-radius: 100px;
		background: rgba(250, 248, 244, 0.55);
		backdrop-filter: blur(22px) saturate(190%);
		-webkit-backdrop-filter: blur(22px) saturate(190%);
		border: 1px solid rgba(255, 255, 255, 0.7);
		overflow: hidden;
	}

	.header-sheen {
		position: absolute;
		inset: 0;
		border-radius: 100px;
		pointer-events: none;
		background: linear-gradient(
			122deg,
			rgba(255, 255, 255, 0.85) 0%,
			rgba(255, 255, 255, 0.12) 26%,
			rgba(255, 255, 255, 0) 48%,
			rgba(255, 255, 255, 0.22) 72%,
			rgba(255, 255, 255, 0.6) 100%
		);
		mix-blend-mode: screen;
	}

	.header-logo {
		position: relative;
		display: flex;
		align-items: center;
		gap: 10px;
		white-space: nowrap;
	}

	.header-logo img {
		height: 34px;
		width: auto;
		display: block;
		border-radius: 8px;
	}

	.header-nav {
		position: relative;
		display: flex;
		align-items: center;
		gap: 4px;
		font-size: 14px;
		font-weight: 400;
	}

	.header-nav a {
		padding: 9px 15px;
		border-radius: 100px;
		transition: background 0.3s ease, color 0.3s ease;
	}

	.header-nav a:hover {
		background: rgba(255, 255, 255, 0.75);
		color: var(--color-text);
	}

	.header-actions {
		position: relative;
		display: flex;
		align-items: center;
		gap: 12px;
	}

	.lang-switch {
		display: flex;
		gap: 2px;
		padding: 3px;
		border-radius: 100px;
		background: rgba(255, 255, 255, 0.5);
		border: 1px solid rgba(255, 255, 255, 0.7);
		font-size: 12px;
		letter-spacing: 0.06em;
	}

	.lang-switch a,
	.lang-active {
		padding: 5px 10px;
		border-radius: 100px;
		display: inline-block;
	}

	.lang-active {
		background: #fff;
		color: var(--color-text);
	}

	.lang-switch a {
		color: #8d857a;
	}

	.header-cta {
		display: inline-block;
		padding: 12px 24px;
		border-radius: 100px;
		background: var(--color-text);
		color: var(--color-bg);
		font-size: 13.5px;
		letter-spacing: 0.04em;
		white-space: nowrap;
		transition: background 0.3s ease, color 0.3s ease;
	}

	.header-cta:hover {
		background: var(--color-gold);
		color: #fff;
	}

	.header-burger {
		display: none;
		position: relative;
		flex-direction: column;
		justify-content: center;
		align-items: center;
		gap: 5px;
		width: 44px;
		height: 44px;
		border-radius: 50%;
		background: transparent;
		flex-shrink: 0;
	}

	.header-burger span {
		display: block;
		width: 18px;
		height: 1.5px;
		border-radius: 2px;
		background: var(--color-text);
		transition: transform 0.3s ease, opacity 0.3s ease;
	}

	.header-burger[aria-expanded="true"] span:nth-child(1) {
		transform: translateY(6.5px) rotate(45deg);
	}

	.header-burger[aria-expanded="true"] span:nth-child(2) {
		opacity: 0;
	}

	.header-burger[aria-expanded="true"] span:nth-child(3) {
		transform: translateY(-6.5px) rotate(-45deg);
	}

	.mobile-nav {
		position: fixed;
		inset: 0;
		z-index: 80;
		display: flex;
		flex-direction: column;
		justify-content: center;
		gap: 40px;
		padding: 100px 32px 48px;
		background: var(--color-bg);
		opacity: 0;
		visibility: hidden;
		transform: translateY(-8px);
		transition: opacity 0.3s ease, transform 0.3s ease, visibility 0s linear 0.3s;
	}

	.mobile-nav.is-open {
		opacity: 1;
		visibility: visible;
		transform: translateY(0);
		transition: opacity 0.3s ease, transform 0.3s ease, visibility 0s linear 0s;
	}

	.mobile-nav nav {
		display: flex;
		flex-direction: column;
		gap: 6px;
	}

	.mobile-nav nav a {
		font-family: var(--font-display);
		font-size: clamp(30px, 3.2vw, 42px);
		font-weight: 300;
		line-height: 1.04;
		color: var(--color-text);
	}

	.mobile-nav-footer {
		display: flex;
		align-items: center;
		gap: 16px;
	}

	@media (max-width: 860px) {
		.header-nav,
		.header-actions {
			display: none;
		}

		.header-burger {
			display: flex;
		}
	}

	@media (min-width: 861px) {
		.mobile-nav {
			display: none;
		}
	}
</style>

<script>
	const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
	const panel = document.querySelector<HTMLElement>('[data-mobile-nav]');

	if (toggle && panel) {
		const closeMenu = () => {
			toggle.setAttribute('aria-expanded', 'false');
			panel.classList.remove('is-open');
			document.body.style.overflow = '';
		};

		const openMenu = () => {
			toggle.setAttribute('aria-expanded', 'true');
			panel.classList.add('is-open');
			document.body.style.overflow = 'hidden';
		};

		toggle.addEventListener('click', () => {
			const isOpen = toggle.getAttribute('aria-expanded') === 'true';
			isOpen ? closeMenu() : openMenu();
		});

		panel.querySelectorAll<HTMLAnchorElement>('[data-menu-link]').forEach((link) => {
			link.addEventListener('click', closeMenu);
		});

		window.addEventListener('keydown', (event) => {
			if (event.key === 'Escape') closeMenu();
		});
	}
</script>
