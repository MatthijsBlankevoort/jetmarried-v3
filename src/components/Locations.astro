---
import Photo from './Photo.astro';

interface Location {
	name: string;
	imageLabel: string;
	image?: string;
}

interface Props {
	intro: { title: string; text: string };
	locations: Location[];
}

const { intro, locations } = Astro.props;
// Open on the first place that already has a real photo, not on a placeholder.
const start = Math.max(0, locations.findIndex((loc) => loc.image));
---

<section class="locations-outer" aria-labelledby="locations-title">
	<div class="locations-panel">
		<div class="locations-copy">
			<h2 id="locations-title" class="section-title" data-reveal>{intro.title}</h2>
			<p class="locations-intro" data-reveal>{intro.text}</p>
			<div class="locations-chips" role="group" aria-label={intro.title} data-reveal>
				{
					locations.map((loc, i) => (
						<button type="button" class="loc-chip" class:list={{ 'loc-chip-active': i === start }} data-loc={i} aria-pressed={i === start ? 'true' : 'false'}>
							{loc.name}
						</button>
					))
				}
			</div>
		</div>
		<div class="locations-stage-outer">
			<div class="locations-stage" data-locstage>
				{
					locations.map((loc, i) => (
						<div class="loc-img" class:list={{ 'loc-img-active': i === start }} data-locimg={i} aria-hidden={i !== start ? 'true' : undefined}>
							<Photo src={loc.image} alt={loc.name} label={loc.imageLabel} class="loc-photo" />
							<div class="loc-caption-wrap" class:list={{ 'loc-caption-plain': !loc.image }}>
								<span class="loc-caption">{loc.name}</span>
							</div>
						</div>
					))
				}
			</div>
		</div>
	</div>
</section>

<style>
	.locations-outer {
		padding: clamp(60px, 7vw, 110px) clamp(24px, 4vw, 60px);
	}

	.locations-panel {
		position: relative;
		color: var(--color-text);
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
	}

	.locations-copy {
		padding: clamp(24px, 3vw, 40px) clamp(28px, 4vw, 60px) clamp(24px, 3vw, 40px) 0;
	}

	.locations-copy .section-title {
		margin: 0 0 24px;
		font-size: clamp(34px, 3.8vw, 50px);
		line-height: 1.06;
	}

	.locations-intro {
		margin: 0 0 38px;
		font-size: 16px;
		line-height: 1.85;
		font-weight: 300;
		color: var(--color-text-muted);
		max-width: 44ch;
		text-wrap: pretty;
	}

	.locations-chips {
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
	}

	.loc-chip {
		border: 1px solid var(--color-border-strong);
		background: var(--color-panel-2);
		border-radius: 100px;
		padding: 10px 20px;
		font: inherit;
		font-size: 13.5px;
		font-weight: 300;
		color: inherit;
		cursor: pointer;
		transition: background 0.3s ease, border-color 0.3s ease, color 0.3s ease;
	}

	.loc-chip:focus-visible {
		outline: 2px solid var(--color-gold);
		outline-offset: 2px;
	}

	.loc-chip:hover,
	.loc-chip-active {
		background: var(--color-text);
		border-color: var(--color-text);
		color: var(--color-bg);
	}

	.locations-stage-outer {
		min-height: 540px;
		padding: 22px 22px 22px 0;
	}

	.locations-stage {
		position: relative;
		height: 100%;
		border-radius: 34px;
		overflow: hidden;
	}

	.loc-img {
		position: absolute;
		inset: 0;
		opacity: 0;
		transform: scale(1.04);
		transition: opacity 0.55s ease, transform 0.7s ease;
		border-radius: 34px;
		overflow: hidden;
	}

	.loc-img-active {
		opacity: 1;
		transform: scale(1);
	}

	.loc-img :global(.loc-photo) {
		position: absolute;
		inset: 0;
		align-items: flex-start;
		padding: 24px;
	}

	.loc-caption-wrap {
		position: absolute;
		inset: 0;
		display: flex;
		align-items: flex-end;
		padding: 24px;
		pointer-events: none;
		background: linear-gradient(to top, rgba(20, 17, 13, 0.75), rgba(20, 17, 13, 0) 55%);
	}

	.loc-caption {
		font-family: var(--font-display);
		font-size: 26px;
		line-height: 1.1;
		color: var(--color-bg);
	}

	/* No photo yet: the caption sits on the striped placeholder, so drop the dark scrim. */
	.loc-caption-plain {
		background: none;
	}

	.loc-caption-plain .loc-caption {
		color: var(--color-text);
	}

	@media (max-width: 900px) {
		.locations-panel {
			grid-template-columns: minmax(0, 1fr);
		}

		.locations-copy {
			padding-right: 0;
		}

		/* One swipeable row instead of seven stacked chips, so the photo stays in view. */
		.locations-chips {
			flex-wrap: nowrap;
			overflow-x: auto;
			scrollbar-width: none;
			margin: 0 calc(-1 * clamp(24px, 4vw, 60px));
			padding: 2px clamp(24px, 4vw, 60px) 6px;
			scroll-padding-inline: clamp(24px, 4vw, 60px);
			-webkit-mask-image: linear-gradient(to right, transparent, black 24px, black calc(100% - 24px), transparent);
			mask-image: linear-gradient(to right, transparent, black 24px, black calc(100% - 24px), transparent);
		}

		.locations-chips::-webkit-scrollbar {
			display: none;
		}

		.loc-chip {
			flex: 0 0 auto;
			white-space: nowrap;
		}

		.locations-stage-outer {
			padding: 18px 0 0;
			min-height: 380px;
		}
	}
</style>
