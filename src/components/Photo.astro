---
interface Props {
	src?: string | null;
	alt?: string;
	label: string;
	class?: string;
}

const { src, alt = '', label, class: className } = Astro.props;
---

<div class:list={['photo-placeholder', className]}>
	{src ? <img src={src} alt={alt} /> : <span class="photo-placeholder__label">{label}</span>}
</div>
