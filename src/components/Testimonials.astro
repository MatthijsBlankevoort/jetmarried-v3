---
import { useTranslations } from '../i18n/ui';

interface Testimonial {
	quote: string;
	author: string;
	highlight?: boolean;
}

interface Props {
	testimonials: Testimonial[];
	linkLabel: string;
	/** Where all reviews live. Without it the link is hidden rather than pointing nowhere. */
	linkUrl?: string;
}

const { testimonials, linkLabel, linkUrl } = Astro.props;
const t = useTranslations(Astro.currentLocale);
---

<section id="verhalen" class="testimonials" aria-labelledby="testimonials-title">
	<div class="testimonials-head">
		<h2 id="testimonials-title" class="section-title" data-reveal>{t('testimonials.title')}</h2>
		{
			linkUrl && (
				<a href={linkUrl} class="btn btn-bordered" target="_blank" rel="noopener" data-reveal>
					{linkLabel}
				</a>
			)
		}
	</div>

	<div class="testimonials-viewport" role="region" aria-labelledby="testimonials-title" tabindex="0" data-rev-view>
		<div class="testimonials-track" data-rev-track>
			{
				testimonials.map((item, i) => (
					<figure class="testimonial-card" class:list={{ 'testimonial-card-highlight': item.highlight }} data-rev>
						<div class="testimonial-top" aria-hidden="true">
							<div class="quote-mark">&ldquo;</div>
							<div class="testimonial-index">
								{String(i + 1).padStart(2, '0')} / {String(testimonials.length).padStart(2, '0')}
							</div>
						</div>
						<blockquote class="testimonial-quote">{item.quote}</blockquote>
						<figcaption class="testimonial-author">{item.author}</figcaption>
					</figure>
				))
			}
		</div>
	</div>

	<div class="testimonials-controls">
		<div class="testimonials-bar">
			<div class="testimonials-bar-fill" data-rev-bar></div>
		</div>
		<div class="testimonials-arrows">
			<button type="button" class="arrow-btn" aria-label={t('testimonials.prev')} data-rev-prev>
				<span aria-hidden="true">←</span>
			</button>
			<button type="button" class="arrow-btn" aria-label={t('testimonials.next')} data-rev-next>
				<span aria-hidden="true">→</span>
			</button>
		</div>
	</div>
</section>

<style>
	.testimonials {
		padding: clamp(60px, 7vw, 110px) clamp(24px, 4vw, 60px);
	}

	.testimonials-head {
		display: flex;
		flex-wrap: wrap;
		align-items: flex-end;
		justify-content: space-between;
		gap: 20px;
		margin-bottom: 48px;
	}

	.testimonials-head :global(.btn-bordered) {
		padding: 13px 24px;
		font-size: 14px;
	}

	.testimonials-viewport {
		overflow: hidden;
		margin: 0 calc(-1 * clamp(24px, 4vw, 60px));
		padding: 8px clamp(24px, 4vw, 60px) 12px;
		cursor: grab;
		touch-action: pan-y;
	}

	.testimonials-viewport:focus-visible {
		outline: 2px solid var(--color-gold);
		outline-offset: -2px;
		border-radius: 26px;
	}

	.testimonials-track {
		display: flex;
		gap: 18px;
		width: max-content;
		will-change: transform;
	}

	.testimonial-card {
		margin: 0;
		width: min(400px, calc(100vw - 72px));
		border-radius: 26px;
		background: var(--color-panel-2);
		padding: 38px 34px;
		display: flex;
		flex-direction: column;
		transition: border-color 0.35s ease;
		border: 1px solid var(--color-border);
	}

	.testimonial-card:hover {
		border-color: var(--color-border-strong);
	}

	.testimonial-card-highlight {
		border-color: var(--color-border-strong);
	}

	.testimonial-top {
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin-bottom: 18px;
	}

	.quote-mark {
		font-family: var(--font-display);
		font-size: 44px;
		line-height: 0.6;
		color: var(--color-gold-light);
	}

	.testimonial-card-highlight .quote-mark {
		color: var(--color-gold);
	}

	.testimonial-index {
		font: 400 11.5px/1 'Jost', sans-serif;
		letter-spacing: 0.16em;
		color: var(--color-text-muted);
	}

	.testimonial-quote {
		margin: 0 0 auto;
		font-size: 19px;
		line-height: 1.65;
		font-weight: 300;
		color: var(--color-text);
		text-wrap: pretty;
	}

	.testimonial-author {
		margin-top: 26px;
		padding-top: 18px;
		border-top: 1px solid var(--color-border);
		font-size: 12.5px;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--color-text-muted);
	}

	.testimonials-controls {
		display: flex;
		align-items: center;
		gap: 16px;
		margin-top: 26px;
	}

	.testimonials-bar {
		position: relative;
		flex: 1;
		height: 2px;
		background: var(--color-border);
		border-radius: 2px;
	}

	.testimonials-bar-fill {
		position: absolute;
		left: 0;
		top: 0;
		height: 100%;
		width: 100%;
		background: var(--color-gold);
		border-radius: 2px;
		transform: scaleX(0.22);
		transform-origin: left;
	}

	.testimonials-arrows {
		display: flex;
		gap: 10px;
		flex: 0 0 auto;
	}

	.arrow-btn {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 46px;
		height: 46px;
		border-radius: 50%;
		border: 1px solid var(--color-border-soft);
		background: transparent;
		color: var(--color-text-muted);
		font: inherit;
		font-size: 17px;
		line-height: 1;
		cursor: pointer;
		user-select: none;
		transition: background 0.3s ease, border-color 0.3s ease, color 0.3s ease;
	}

	.arrow-btn:focus-visible {
		outline: 2px solid var(--color-gold);
		outline-offset: 3px;
	}

	.arrow-btn:hover {
		background: var(--color-text);
		border-color: var(--color-text);
		color: var(--color-bg);
	}
</style>
