---
interface Step {
	number: string;
	title: string;
	text: string;
	tag: string;
}

interface Props {
	title: string;
	steps: Step[];
}

const { title, steps } = Astro.props;
---

<section id="werkwijze" class="werkwijze" aria-labelledby="werkwijze-title">
	<h2 id="werkwijze-title" class="section-title werkwijze-title" data-reveal>{title}</h2>

	<ol class="steps">
		<li class="steps-line" aria-hidden="true"></li>
		<li class="steps-line steps-line-active" aria-hidden="true" data-step-bar></li>

		{
			steps.map((step) => (
				<li class="step" data-step>
					<div class="step-dot-col" aria-hidden="true">
						<span class="step-dot" data-step-dot />
					</div>
					<div class="step-card" data-step-card>
						<div>
							<div class="step-number" aria-hidden="true">
								{step.number}
							</div>
							<h3 class="step-title">{step.title}</h3>
						</div>
						<div>
							<p class="step-text">{step.text}</p>
							<p class="step-tag">
								<span class="step-tag-dash" aria-hidden="true" />
								{step.tag}
							</p>
						</div>
					</div>
				</li>
			))
		}
	</ol>
</section>

<style>
	.werkwijze {
		padding: clamp(60px, 7vw, 110px) clamp(24px, 4vw, 60px);
	}

	.werkwijze-title {
		margin: 0 0 clamp(40px, 5vw, 64px);
		max-width: 20ch;
		text-wrap: balance;
	}

	.steps {
		position: relative;
		list-style: none;
		margin: 0;
		padding: 8px 0;
		display: flex;
		flex-direction: column;
		gap: clamp(18px, 2.4vw, 30px);
		--p: 0;
	}

	.steps-line {
		position: absolute;
		left: 31px;
		top: 0;
		bottom: 0;
		width: 2px;
		border-radius: 2px;
		background: linear-gradient(to bottom, transparent 0%, var(--color-border) 9%, var(--color-border) 91%, transparent 100%);
	}

	.steps-line-active {
		background: linear-gradient(to bottom, transparent 0%, var(--color-gold) 9%, var(--color-gold) 91%, transparent 100%);
		transform: scaleY(var(--p));
		transform-origin: top;
	}

	.step {
		display: grid;
		grid-template-columns: 64px 1fr;
		gap: clamp(14px, 2vw, 28px);
		align-items: start;
	}

	.step-dot-col {
		display: flex;
		justify-content: center;
		padding-top: clamp(30px, 3vw, 40px);
	}

	.step-dot {
		position: relative;
		z-index: 1;
		width: 15px;
		height: 15px;
		border-radius: 50%;
		background: var(--color-bg);
		border: 2px solid var(--color-gold-light);
	}

	.step-card {
		border-radius: 26px;
		background: var(--color-panel-2);
		border: 1px solid var(--color-border);
		padding: clamp(26px, 3vw, 40px) clamp(24px, 3vw, 40px);
		display: grid;
		grid-template-columns: minmax(170px, 0.6fr) 1.4fr;
		gap: clamp(16px, 3vw, 48px);
		align-items: start;
	}

	.step-number {
		font-family: var(--font-display);
		font-style: italic;
		font-size: clamp(36px, 3.4vw, 46px);
		line-height: 1;
		color: var(--color-gold);
		margin-bottom: 12px;
	}

	.step-title {
		margin: 0;
		font-size: 20px;
		font-weight: 500;
		letter-spacing: 0.01em;
	}

	.step-text {
		margin: 0 0 16px;
		font-size: 16.5px;
		line-height: 1.8;
		font-weight: 300;
		color: var(--color-text-muted);
		max-width: 52ch;
		text-wrap: pretty;
	}

	.step-tag {
		margin: 0;
		display: inline-flex;
		align-items: center;
		gap: 10px;
		font-size: 13px;
		font-weight: 500;
		letter-spacing: 0.02em;
		color: var(--color-gold-deep);
	}

	.step-tag-dash {
		width: 18px;
		height: 1px;
		background: var(--color-gold);
		display: inline-block;
		flex: 0 0 auto;
	}

	/* Wide screens: the four steps read left to right as one row, the line runs across the top. */
	@media (min-width: 1100px) {
		.steps {
			display: grid;
			grid-template-columns: repeat(4, 1fr);
			gap: 18px;
			padding: 0;
		}

		.steps-line {
			left: 0;
			right: 0;
			top: 6.5px;
			bottom: auto;
			width: auto;
			height: 2px;
			background: linear-gradient(to right, transparent 0%, var(--color-border) 4%, var(--color-border) 96%, transparent 100%);
		}

		.steps-line-active {
			background: linear-gradient(to right, transparent 0%, var(--color-gold) 4%, var(--color-gold) 96%, transparent 100%);
			transform: scaleX(var(--p));
			transform-origin: left;
		}

		.step {
			grid-template-columns: 1fr;
			grid-template-rows: auto 1fr;
			gap: 26px;
		}

		.step-dot-col {
			justify-content: flex-start;
			padding: 0 0 0 clamp(26px, 2.4vw, 34px);
		}

		.step-card {
			height: 100%;
			grid-template-columns: 1fr;
			gap: 14px;
			padding: clamp(26px, 2.2vw, 34px);
		}

		.step-text {
			font-size: 16px;
			line-height: 1.75;
		}
	}

	@media (max-width: 640px) {
		.step {
			grid-template-columns: 32px 1fr;
		}

		.steps-line {
			left: 15px;
		}

		.step-card {
			grid-template-columns: 1fr;
		}
	}
</style>
