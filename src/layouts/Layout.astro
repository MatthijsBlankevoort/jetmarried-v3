---
interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'Jetmarried — Mariëtte Boot, trouwambtenaar op Texel',
	description = 'Een ceremonie moet passen als een warme jas. Ik luister, schrijf jullie verhaal op en spreek het uit alsof ik erbij was.',
} = Astro.props;
---

<!doctype html>
<html lang="nl">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<title>{title}</title>

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;1,300;1,400&family=Jost:wght@300;400;500&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		<slot />
	</body>
</html>

<style is:global>
	:root {
		--color-bg: #faf8f4;
		--color-text: #2c2a26;
		--color-text-muted: #5a554d;
		--color-text-mutedest: #8a8378;
		--color-gold: #9c7a55;
		--color-gold-light: #c6b99f;
		--color-gold-pale: #f0dcc2;
		--color-panel: #f7f2e7;
		--color-panel-2: #faf8f4;
		--color-border: #e2dacb;
		--color-border-strong: #ddd0b6;
		--color-border-soft: #ddd4c3;
		--color-dark: #2c2a26;
		--color-dark-text: #f4efe4;
		--color-dark-accent: #c0a077;
		--placeholder-a: #e9e2d5;
		--placeholder-b: #e0d8c8;
		--placeholder-text: #8a8378;

		--font-display: 'Cormorant Garamond', 'Jost', sans-serif;
		--font-body: 'Jost', system-ui, sans-serif;
	}

	* {
		box-sizing: border-box;
	}

	html {
		scroll-behavior: smooth;
	}

	body {
		margin: 0;
		background: var(--color-bg);
		color: var(--color-text);
		font-family: var(--font-body);
		overflow-x: clip;
		position: relative;
	}

	h1,
	h2,
	h3,
	h4,
	h5,
	h6,
	p,
	span,
	div,
	a,
	em,
	strong,
	li,
	input,
	textarea,
	button,
	label {
		font-family: inherit;
	}

	em,
	i {
		font-style: italic;
	}

	a {
		color: inherit;
		text-decoration: none;
	}

	::selection {
		background: var(--color-gold-pale);
	}

	@keyframes jm-float {
		0%,
		100% {
			transform: translateY(0);
		}
		50% {
			transform: translateY(-9px);
		}
	}

	/* Shared placeholder "FOTO" block used across sections until a real image is set */
	.photo-placeholder {
		background-color: var(--placeholder-a);
		background-image: repeating-linear-gradient(135deg, var(--placeholder-a) 0 9px, var(--placeholder-b) 9px 18px);
		display: flex;
		align-items: flex-end;
		overflow: hidden;
	}

	.photo-placeholder img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}

	.photo-placeholder__label {
		font: 400 11px/1.4 'Jost', sans-serif;
		color: var(--placeholder-text);
		letter-spacing: 0.06em;
	}
</style>
