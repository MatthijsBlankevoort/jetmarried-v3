---
interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'Jetmarried — Mariëtte Boot, trouwambtenaar op Texel',
	description = 'Een ceremonie moet passen als een warme jas. Ik luister, schrijf jullie verhaal op en spreek het uit alsof ik erbij was.',
} = Astro.props;
---

<!doctype html>
<html lang="nl">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" href="/favicon.ico" sizes="any" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
		<link rel="icon" type="image/png" sizes="512x512" href="/favicon-512.png" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<title>{title}</title>

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;1,300;1,400&family=Jost:wght@300;400;500&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		<slot />
		<script src="../scripts/site-animations.js"></script>
	</body>
</html>

<style is:global>
	:root {
		--color-bg: #faf5ec;
		--color-text: #2c2a26;
		--color-text-muted: #5a554d;
		--color-text-mutedest: #8a8378;
		--color-gold: #9c7a55;
		--color-gold-light: #c6b99f;
		--color-gold-pale: #f0dcc2;
		--color-panel: #f7f2e7;
		--color-panel-2: #faf8f4;
		--color-border: #e2dacb;
		--color-border-strong: #ddd0b6;
		--color-border-soft: #ddd4c3;
		--color-dark: #2c2a26;
		--color-dark-text: #f4efe4;
		--color-dark-accent: #c0a077;
		--placeholder-a: #e9e2d5;
		--placeholder-b: #e0d8c8;
		--placeholder-text: #8a8378;

		--font-display: 'Cormorant Garamond', 'Jost', sans-serif;
		--font-body: 'Jost', system-ui, sans-serif;
	}

	* {
		box-sizing: border-box;
	}

	html {
		scroll-behavior: smooth;
	}

	body {
		margin: 0;
		background: var(--color-bg);
		color: var(--color-text);
		font-family: var(--font-body);
		overflow-x: clip;
		position: relative;
	}

	/* Caps content width on very large (XXL) screens so sections don't stretch edge-to-edge */
	main {
		max-width: 1600px;
		margin-inline: auto;
	}

	h1,
	h2,
	h3,
	h4,
	h5,
	h6,
	p,
	span,
	div,
	a,
	em,
	strong,
	li,
	input,
	textarea,
	button,
	label {
		font-family: inherit;
	}

	em,
	i {
		font-style: italic;
	}

	a {
		color: inherit;
		text-decoration: none;
	}

	::selection {
		background: var(--color-gold-pale);
	}

	@keyframes jm-float {
		0%,
		100% {
			transform: translateY(0);
		}
		50% {
			transform: translateY(-9px);
		}
	}

	/* Shared section heading styles reused across every section */
	.eyebrow {
		font-size: 12px;
		letter-spacing: 0.22em;
		text-transform: uppercase;
		color: var(--color-gold);
		margin-bottom: 22px;
	}

	.section-title {
		margin: 0;
		font-family: var(--font-display);
		font-weight: 300;
		font-size: clamp(36px, 4.2vw, 56px);
		line-height: 1.04;
	}

	/* Shared button styles reused across every section */
	.btn {
		display: inline-block;
		border-radius: 100px;
		font-size: 15px;
		transition: background 0.3s ease, color 0.3s ease, border-color 0.3s ease;
	}

	.btn-bordered {
		padding: 15px 28px;
		border: 1px solid var(--color-border-soft);
		font-size: 14.5px;
	}

	.btn-bordered:hover {
		background: var(--color-text);
		color: var(--color-bg);
		border-color: var(--color-text);
	}

	/* Shared placeholder "FOTO" block used across sections until a real image is set */
	.photo-placeholder {
		position: relative;
		background-color: var(--placeholder-a);
		background-image: repeating-linear-gradient(135deg, var(--placeholder-a) 0 9px, var(--placeholder-b) 9px 18px);
		display: flex;
		align-items: flex-end;
		overflow: hidden;
	}

	/* Positioned absolutely so the padding/flex layout used to place the label
	   text doesn't inset the real photo once one is set. */
	.photo-placeholder img {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}

	.photo-placeholder__label {
		font: 400 11px/1.4 'Jost', sans-serif;
		color: var(--placeholder-text);
		letter-spacing: 0.06em;
	}
</style>
