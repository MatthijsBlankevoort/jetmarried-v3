---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import Photo from '../../../components/Photo.astro';
import { locales, localeParam, localePath, formatDate, useTranslations, type Locale } from '../../../i18n/ui';
import { getPosts, getSettings, postSlug } from '../../../lib/content';

export const getStaticPaths = (async () => {
	const paths = await Promise.all(
		locales.map(async (locale) => {
			const posts = await getPosts(locale);
			return posts.map((post) => ({
				params: { locale: localeParam(locale), slug: postSlug(post.id) },
				props: { post, locale },
			}));
		}),
	);
	return paths.flat();
}) satisfies GetStaticPaths;

const { post, locale } = Astro.props;
const t = useTranslations(locale);
const { Content } = await render(post);
const settings = await getSettings(locale);

const dateLabel = formatDate(post.data.date, locale);
---

<Layout title={`${post.data.title} — Jetmarried`} description={post.data.excerpt}>
	<Header nav={settings.nav} logoUrl={settings.logoUrl} headerCta={settings.headerCta} />
	<main>
		<article class="post">
			<div class="post-head">
				<div class="eyebrow" data-reveal>{dateLabel}</div>
				<h1 class="section-title post-title" data-reveal>{post.data.title}</h1>
			</div>
			<Photo src={post.data.cover} alt={post.data.title} label={post.data.coverLabel} class="post-cover" />
			<div class="post-body" data-reveal>
				<Content />
			</div>
			<a href={localePath(locale, '/blog/')} class="btn btn-bordered post-back">{t('blog.back')}</a>
		</article>
	</main>
	<Footer contactName={settings.contactName} kvk={settings.kvk} socials={settings.footerSocials} logoUrl={settings.logoUrl} />
</Layout>

<style>
	.post {
		max-width: 780px;
		margin: 0 auto;
		padding: clamp(140px, 14vw, 180px) clamp(24px, 4vw, 60px) clamp(60px, 7vw, 110px);
	}

	.post-head {
		margin-bottom: 32px;
	}

	.post-title {
		margin: 0;
		font-size: clamp(34px, 4vw, 50px);
		line-height: 1.08;
	}

	.post :global(.post-cover) {
		aspect-ratio: 16 / 9;
		border-radius: 30px;
		padding: 20px;
		margin-bottom: 40px;
	}

	.post-body {
		font-size: 17px;
		line-height: 1.85;
		font-weight: 300;
		color: var(--color-text-muted);
	}

	.post-body :global(h2) {
		font-family: var(--font-display);
		font-weight: 400;
		font-size: 30px;
		color: var(--color-text);
		margin: 40px 0 16px;
	}

	.post-body :global(p) {
		margin: 0 0 20px;
		text-wrap: pretty;
	}

	.post-body :global(ul) {
		margin: 0 0 20px;
		padding-left: 20px;
	}

	.post-body :global(li) {
		margin-bottom: 8px;
	}

	.post-back {
		display: inline-block;
		margin-top: 44px;
	}
</style>
