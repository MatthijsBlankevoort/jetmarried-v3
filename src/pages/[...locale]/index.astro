---
import type { GetStaticPaths } from 'astro';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Hero from '../../components/Hero.astro';
import Marquee from '../../components/Marquee.astro';
import About from '../../components/About.astro';
import Ceremonies from '../../components/Ceremonies.astro';
import Werkwijze from '../../components/Werkwijze.astro';
import Locations from '../../components/Locations.astro';
import Testimonials from '../../components/Testimonials.astro';
import Faq from '../../components/Faq.astro';
import BlogTeasers from '../../components/BlogTeasers.astro';
import Contact from '../../components/Contact.astro';
import Footer from '../../components/Footer.astro';
import { locales, localeParam, type Locale } from '../../i18n/ui';
import { getHome, getPosts, getSettings, postKey, postSlug } from '../../lib/content';
import { localePath } from '../../i18n/ui';

export const getStaticPaths = (() =>
	locales.map((locale) => ({
		params: { locale: localeParam(locale) },
		props: { locale },
	}))) satisfies GetStaticPaths;

const { locale } = Astro.props as { locale: Locale };

const settings = await getSettings(locale);
const home = await getHome(locale);

// "Read my story" opens the post about how Mariëtte became an officiant.
const storyPost = (await getPosts(locale)).find((post) => postKey(post.id) === 'ja-ik-wil');
const storyHref = storyPost ? localePath(locale, `/blog/${postSlug(storyPost)}/`) : localePath(locale, '/blog/');
---

<Layout>
	<Header nav={settings.nav} logoUrl={settings.logoUrl} headerCta={settings.headerCta} />
	<main>
		<Hero titleLine1={home.hero.titleLine1} titleLine2={home.hero.titleLine2} text={home.hero.text} image={home.hero.image} />
		<Marquee text={home.marqueeText} />
		<About
			eyebrow={home.about.eyebrow}
			titleLine1={home.about.titleLine1}
			titleLine2={home.about.titleLine2}
			paragraph1Before={home.about.paragraph1Before}
			motto={home.about.motto}
			paragraph1After={home.about.paragraph1After}
			paragraph2={home.about.paragraph2}
			image={home.about.image}
			storyHref={storyHref}
			speechExcerpt={home.about.speechExcerpt}
			speechCaption={home.about.speechCaption}
		/>
		<Ceremonies intro={home.ceremoniesIntro} ceremonies={home.ceremonies} />
		<Werkwijze title={home.werkwijze.title} steps={home.werkwijze.steps} />
		<Locations intro={home.locationsIntro} locations={home.locations} />
		<Testimonials testimonials={home.testimonials} linkLabel={home.testimonialsLinkLabel} linkUrl={home.testimonialsLinkUrl} />
		<BlogTeasers locale={locale} />
		{/* The FAQ settles the last doubts (price, rain, municipality) right before the form. */}
		<Faq faqs={home.faq} phone={settings.phone} phoneHref={settings.phoneHref} />
		<Contact
			titleLine1={home.contact.titleLine1}
			titleLine2={home.contact.titleLine2}
			text={home.contact.text}
			contactName={settings.contactName}
			phone={settings.phone}
			phoneHref={settings.phoneHref}
			email={settings.email}
			priceNote={settings.priceNote}
			ceremonies={home.ceremonies.map(({ id, title }) => ({ id, title }))}
			motto={home.about.motto}
			formEndpoint={settings.formEndpoint}
			privacyUrl={settings.privacyUrl}
		/>
	</main>
	<Footer contactName={settings.contactName} kvk={settings.kvk} socials={settings.footerSocials} logoUrl={settings.logoUrl} />
</Layout>
